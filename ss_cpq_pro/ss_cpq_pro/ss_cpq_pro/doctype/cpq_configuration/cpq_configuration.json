{
 "doctype": "DocType",
 "name": "CPQ Configuration",
 "module": "SS CPQ Pro",
 "engine": "InnoDB",
 "title_field": "item",
 "field_order": [
  "item", "item_name", "customer", "qty", "status", "section_break_1",
  "configuration_details", "column_break_1", "base_price", "total_price", "sales_order"
 ],
 "fields": [
  {"fieldname": "item", "fieldtype": "Link", "label": "Item", "options": "Item", "reqd": 1, "in_list_view": 1},
  {"fieldname": "item_name", "fieldtype": "Data", "label": "Item Name", "fetch_from": "item.item_name", "read_only": 1},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer", "in_list_view": 1},
  {"fieldname": "qty", "fieldtype": "Float", "label": "Qty", "default": "1"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nConverted", "default": "Draft", "read_only": 1, "in_list_view": 1},
  {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Configuration"},
  {"fieldname": "configuration_details", "fieldtype": "Table", "label": "Selected Options", "options": "CPQ Configuration Detail", "read_only": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "base_price", "fieldtype": "Currency", "label": "Base Price", "read_only": 1},
  {"fieldname": "total_price", "fieldtype": "Currency", "label": "Total Price", "read_only": 1, "in_list_view": 1},
  {"fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "options": "Sales Order", "read_only": 1, "in_list_view": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Sales User", "read": 1, "write": 1, "create": 1},
  {"role": "Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
 ]
}
